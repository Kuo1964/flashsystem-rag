# ── IBM watsonx.ai 認證（--llm watsonx，預設）────────────────────────────
WATSONX_APIKEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# 使用的 LLM 模型（可選，預設 ibm/granite-13b-chat-v2）
# 其他選項：meta-llama/llama-3-70b-instruct、ibm/granite-3-8b-instruct
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

# ── Google Gemini 認證（--llm gemini）────────────────────────────────────
# 取得方式：https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_ai_studio_api_key_here
# 可選，預設 gemini-2.0-flash
# 其他選項：gemini-1.5-pro、gemini-2.0-flash-lite
GEMINI_MODEL_ID=gemini-2.0-flash

# 資料來源路徑
RAG_PDF_DIR=/Volumes/SSD_4TB/RAG/raw_data/pdfs
RAG_URL_FILE=/Volumes/SSD_4TB/RAG/raw_data/web_urls.txt
RAG_JSON_DIR=/Volumes/SSD_4TB/RAG/raw_data/manual_docs

# 向量資料庫儲存路徑
RAG_VECTOR_DIR=/Volumes/SSD_4TB/RAG/vectorstore
RAG_COLLECTION=flashsystem_all
